// Cloudflare Worker for vitalacoustica.com: the built site plus the enquiry form's email sender.
// Cloudflare runs `npm run build`, then `npx wrangler deploy`, which reads this file.
{
  "name": "vitalacoustica-website",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // any page address serves the app, which picks the page itself
    "not_found_handling": "single-page-application",
    // the form's address reaches the Worker, not the files
    "run_worker_first": ["/api/*"]
  },
  // the enquiry emails' sender and the site's address; the Resend key is a secret, set in the dashboard
  "vars": {
    "ENQUIRY_FROM": "Vital Acoustica <no-reply@vitalacoustica.com>",
    "SITE_URL": "https://vitalacoustica.com"
  },
  // keep anything else set in the dashboard (e.g. ENQUIRY_TO, ENQUIRY_CC) when deploying
  "keep_vars": true,
  "observability": { "enabled": true }
}
