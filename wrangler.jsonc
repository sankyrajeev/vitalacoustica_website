// Cloudflare Worker for vitalacoustica.com: the built site, the forms' email sender, and the Journal
// (its pages' metadata, its articles, Industry Pulse and The Acoustica Edit sign-up).
// Cloudflare runs `npm run build`, then `npx wrangler deploy`, which reads this file.
{
  "name": "vitalacoustica-website",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // any page address serves the app, which picks the page itself
    "not_found_handling": "single-page-application",
    // these addresses reach the Worker first: the forms and data under /api/, the Journal's pages
    // (to add each page's own title, description and sharing tags), and the sitemap
    "run_worker_first": ["/api/*", "/journal", "/journal/*", "/sitemap.xml"]
  },
  // the enquiry emails' sender and the site's address; the Resend key is a secret, set in the dashboard
  "vars": {
    "ENQUIRY_FROM": "Vital Acoustica <no-reply@vitalacoustica.com>",
    "SITE_URL": "https://vitalacoustica.com"
  },
  // keep anything else set in the dashboard (e.g. ENQUIRY_TO, ENQUIRY_CC, RESEND_AUDIENCE_ID) when deploying
  "keep_vars": true,
  // customer accounts and software licences use a D1 database: add its binding here once it's created
  // (docs/accounts.md, step 1). Until then the account pages say accounts aren't available yet.
  //   "d1_databases": [{ "binding": "DB", "database_name": "vitalacoustica", "database_id": "…" }],
  "observability": { "enabled": true }
}
