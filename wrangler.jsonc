// Cloudflare Worker for vitalacoustica.com: the built site plus the enquiry form's email sender.
// Cloudflare runs `npm run build`, then `npx wrangler deploy`, which reads this file.
{
  "name": "vitalacoustica-website",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // any page address serves the app, which picks the page itself
    "not_found_handling": "single-page-application",
    // the form's address reaches the Worker, not the files
    "run_worker_first": ["/api/*"]
  },
  // keep the variables set in the dashboard (ENQUIRY_FROM, SITE_URL…) when deploying
  "keep_vars": true,
  "observability": { "enabled": true }
}
